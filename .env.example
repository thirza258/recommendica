SECRET_KEY=your-secret-key
OPENAI_API_KEY=
DEVELOPMENT_MODE=True
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0,recommendica.nevatal.tech,.nevatal.tech
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://recommendica.nevatal.tech,http://recommendica.nevatal.tech
CSRF_TRUSTED_ORIGINS=https://recommendica.nevatal.tech,http://recommendica.nevatal.tech
DATABASE_URL=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=True

# ChromaDB
RE_CHROMA_HOST=localhost
RE_CHROMA_PORT=5050
# When Chroma is unreachable the app fails loudly (503 + readiness error).
# Set to True only for demos: it substitutes an EMPTY in-memory collection,
# so every search returns no documents.
CHROMA_ALLOW_EPHEMERAL_FALLBACK=False

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
DEFAULT_LLM_MODEL=google/gemma-4-26b-a4b-it

# ── AI / RAG Pipeline ───────────────────────────────────────────────────────

# Embedding — this must be a model Ollama actually serves, and the same one
# used to index the collection (a mismatched model or dimension makes every
# query fail).  Check with: GET /api/v1/health/ready/
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_BATCH_SIZE=100
EMBEDDING_TIMEOUT=60
EMBEDDING_CACHE_MAX_SIZE=1024

# LLM
DENSE_LLM_MODEL=google/gemini-3-flash-preview
LLM_TEMPERATURE=0
LLM_REQUEST_TIMEOUT=120
LLM_TRANSFORM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_CACHE_TTL=900
LLM_CACHE_MAX_SIZE=512

# Retrieval
TOP_K=5
CANDIDATE_MULTIPLIER=4
CHUNK_SIZE=5
COLLECTION_NAME=arxiv_embeddings

# ── Pipeline shape / latency dials ──────────────────────────────────────────
# Query transforms run concurrently; each is optional and the stage is bounded.
ENABLE_HYDE=True
ENABLE_STEP_BACK=True
ENABLE_RAG_FUSION=True
VARIANT_MAX_WORKERS=3
VARIANT_STAGE_TIMEOUT=45

# Reciprocal Rank Fusion damping constant.
RRF_K=60

# The main latency dial. Answer generation costs one LLM call per CHUNK_SIZE
# documents, so 12 docs at CHUNK_SIZE=5 is 3 calls (run concurrently).
MAX_CONTEXT_DOCS=12
MAX_DOC_CHARS_IN_PROMPT=1500
GENERATION_MAX_WORKERS=3

# ── Relevance agent ─────────────────────────────────────────────────────────
# Grades every retrieved paper against the query, drops the unrelated ones and,
# when too few survive, rewrites the query using the rejection reasons and
# searches again. Costs one LLM call per attempt.
ENABLE_RELEVANCE_AGENT=True
# Grading needs reliable JSON. Defaults to DEFAULT_LLM_MODEL; point it at a
# cheaper model only after checking the logs for grader parse failures.
AGENT_MODEL=
AGENT_TIMEOUT=30
# Search attempts including the first: 2 means at most one refined retry.
AGENT_MAX_ITERATIONS=2
# Related papers wanted before the agent stops looking.
AGENT_MIN_RELEVANT_DOCS=3
# Candidates graded per attempt.
AGENT_GRADE_CANDIDATES=20
# Minimum relevance score to keep a paper (0-1). Raise to be stricter.
AGENT_RELEVANCE_THRESHOLD=0.5
# Wall-clock budget for the whole loop, whatever the attempt count.
AGENT_DEADLINE=90
AGENT_MAX_CANDIDATE_CHARS=400

# Answer grounding: audits each answer against its sources and fills the UI's
# faithfulness score + claim list. OFF by default — one extra LLM call per
# chunk, on the critical path.
ENABLE_ANSWER_EVALUATION=False
ANSWER_EVALUATION_TIMEOUT=45

# ── Live arXiv fallback ─────────────────────────────────────────────────────
# The indexed collection is a snapshot; a question about work it never ingested
# retrieves nothing related however well the query is refined. When the agent
# ends up short of AGENT_MIN_RELEVANT_DOCS it searches arxiv.org directly and
# grades those papers exactly like local ones before any can reach an answer.
#
# Requires ENABLE_RELEVANCE_AGENT=True — the grader is what holds live results
# to the same standard, so the fallback stays off without it.
#
# If arXiv is unreachable the request is answered from ChromaDB alone and the
# response says so; a failing optional source never costs you the local papers.
ENABLE_ARXIV_FALLBACK=True
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_FALLBACK_MAX_RESULTS=10
ARXIV_FALLBACK_TIMEOUT=15
# arXiv asks clients to space out requests and to identify themselves.
ARXIV_MIN_REQUEST_INTERVAL=3
ARXIV_USER_AGENT=Recommendica/1.0 (research recommender; +https://recommendica.nevatal.tech)
# Content terms per search. They are ANDed, so more terms = narrower search.
ARXIV_MAX_QUERY_TERMS=6
ARXIV_SORT_BY=relevance
# Consecutive failures before the fallback is skipped for a cooldown.
ARXIV_BREAKER_THRESHOLD=3
ARXIV_BREAKER_COOLDOWN=300

# ── Boundary verification ───────────────────────────────────────────────────
# Query check: screens the input before the pipeline spends anything on it, so
# a greeting or a topicless paste is answered immediately instead of after a
# full run. Fails open — if the check cannot run, the query proceeds.
ENABLE_QUERY_VERIFICATION=True
QUERY_VERIFICATION_TIMEOUT=15
# Only catches what is certainly unusable; "AI" and "RAG" are real topics.
QUERY_MIN_CHARS=2
# Upper bound is a prompt-budget guard, not a style rule: the query is
# interpolated into every transform, grading and generation prompt.
QUERY_MAX_CHARS=1000

# Result check: deterministic report on the selected papers — how many, from
# which source, retrieval confidence, query-term coverage — attached to the
# response as `verification`. No LLM call, so it is on by default.
ENABLE_RESULT_VERIFICATION=True

# ── Serving limits ──────────────────────────────────────────────────────────
MAX_CONCURRENT_QUERIES=8
SSE_HEARTBEAT_SECONDS=15
READINESS_CACHE_SECONDS=10

# Gunicorn (used by the Docker image)
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=900

# Rerank (leave empty to disable)
RERANK_MODEL=
RERANK_TOP_N=
RERANK_TIMEOUT=15
RERANK_BREAKER_THRESHOLD=3
RERANK_BREAKER_COOLDOWN=300

# Query-transform models
HYDE_MODEL=mistralai/mistral-nemo
STEP_BACK_MODEL=anthropic/claude-sonnet-4-6
RAG_FUSION_MODEL=anthropic/claude-sonnet-4-6
RAG_FUSION_N_VARIANTS=4

# Confidence gate
CONFIDENCE_ALPHA=0.5
CONFIDENCE_BETA=0.3
CONFIDENCE_GAMMA=0.2
CONFIDENCE_THRESHOLD=0.75
